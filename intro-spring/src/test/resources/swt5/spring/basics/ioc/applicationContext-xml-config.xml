<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">
    <bean id="consoleLogger"
          class="swt5.spring.basics.ioc.util.ConsoleLogger" />
    
    <bean id="fileLogger"
          class="swt5.spring.basics.ioc.util.FileLogger"
          destroy-method="close">
        <property name="fileName" value="log2.txt"/>
    </bean>
    
    <bean id="worklog" class="swt5.spring.basics.ioc.logic.xmlconfig.WorkLogServiceImpl">
        <constructor-arg ref="consoleLogger" />
    </bean>
</beans>